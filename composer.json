{
    "name": "gebruederheitz/wp-meta-fields",
    "description": "Dependency-less helpers for a faster Wordpress metaboxes setup.",
    "type": "library",
    "license": "GPL-3.0-only",
    "autoload": {
        "psr-4": {
            "Gebruederheitz\\Wordpress\\MetaFields\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Andreas Maros",
            "email": "andreas.maros@gebruederheitz.de"
        }
    ],
    "require": {
	    "php": ">=8.0",
        "gebruederheitz/simple-singleton": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "lint": "phpstan analyse -c .phpstan.neon --memory-limit=1G",
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.0.2"
        }
    }
}
